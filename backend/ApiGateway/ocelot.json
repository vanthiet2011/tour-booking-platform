{
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE"],
      "DownstreamPathTemplate": "/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "auth-service", "Port": 8080 }],
      "Key": "Auth"
    },
    {
      "DownstreamPathTemplate": "/api/users/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "user-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/users/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete"]
    },
    {
      "UpstreamPathTemplate": "/api/userprofiles/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE"],
      "DownstreamPathTemplate": "/userprofiles/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "user-service", "Port": 8080 }],
      "Key": "UserProfiles"
    },
    {
      "UpstreamPathTemplate": "/api/categories",
      "UpstreamHttpMethod": ["GET", "POST"],
      "DownstreamPathTemplate": "/categories",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "UpstreamPathTemplate": "/api/categories/{id}",
      "UpstreamHttpMethod": ["GET", "PUT", "DELETE"],
      "DownstreamPathTemplate": "/categories/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "UpstreamPathTemplate": "/api/tours",
      "UpstreamHttpMethod": ["GET", "POST"],
      "DownstreamPathTemplate": "/tours",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "UpstreamPathTemplate": "/api/tours/{id}",
      "UpstreamHttpMethod": ["GET", "PUT", "DELETE"],
      "DownstreamPathTemplate": "/tours/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "UpstreamPathTemplate": "/api/destinations",
      "UpstreamHttpMethod": ["GET", "POST"],
      "DownstreamPathTemplate": "/destinations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "UpstreamPathTemplate": "/api/destinations/{id}",
      "UpstreamHttpMethod": ["GET", "PUT", "DELETE"],
      "DownstreamPathTemplate": "/destinations/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "UpstreamPathTemplate": "/api/destinations/{id}/tours",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/destinations/{id}/tours",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "UpstreamPathTemplate": "/api/bookings/{everything}",
      "DownstreamPathTemplate": "/bookings/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "booking-service", "Port": 8080 }],
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE"],
      "SwaggerKey": "booking"
    },
    {
      "UpstreamPathTemplate": "/api/files/upload",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamPathTemplate": "/files/upload",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }]
    },
    {
      "DownstreamPathTemplate": "/api/payments/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "payment-service", "Port": 8080 }],
      "UpstreamPathTemplate": "/payments/{everything}",
      "UpstreamHttpMethod": ["Get", "Post", "Put", "Delete"]
    },
    {
      "UpstreamPathTemplate": "/api/files/{everything}",
      "UpstreamHttpMethod": ["POST"],
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "tour-service", "Port": 8080 }],
      "DownstreamPathTemplate": "/files/{everything}"
    },
    {
      "UpstreamPathTemplate": "/uploads/{everything}",
      "UpstreamHttpMethod": ["GET"],
      "DownstreamPathTemplate": "/uploads/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "tour-service",
          "Port": 8080
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8000",
    "CorsOptions": {
      "AllowedOrigins": ["http://localhost:3000"],
      "AllowedHeaders": ["*"],
      "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "AllowCredentials": true
    }
  }
}
