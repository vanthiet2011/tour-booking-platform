{
  "Environment": "dev",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Services": {
    "TourServiceUrl": "http://tour-service:8080"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5435;Database=BookingDb;Username=YOUR_USERNAME;Password=YOUR_DB_PASSWORD_HERE"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_HERE_MUST_BE_AT_LEAST_32_CHARS",
    "Issuer": "AuthService",
    "Audience": "TourBookingPlatform",
    "ExpiryMinutes": 30
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092"
  }
}
