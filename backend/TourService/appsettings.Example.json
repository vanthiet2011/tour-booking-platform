{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=TourDb;Username=YOUR_USERNAME;Password=YOUR_DB_PASSWORD_HERE",
    "Redis": "redis_cache:6379"
  },
  "Kafka": {
    "BootstrapServers": "kafka:9092",
    "GroupId": "tour-service-group"
  },
  "JwtSettings": {
    "SecretKey": "YOUR_SUPER_SECRET_KEY_HERE_MUST_BE_AT_LEAST_32_CHARS",
    "Issuer": "AuthService",
    "Audience": "TourBookingPlatform",
    "ExpiryMinutes": 30
  },
  "ServicePublicUrl": "http://localhost:5003"
}
